<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <AssemblyName>DocumentToImagePlugin</AssemblyName>
    <RootNamespace>Ink_Canvas.Plugins.DocumentToImage</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>AnyCPU;x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\Ink Canvas\Plugins\DocumentToImagePlugin\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\..\Ink Canvas\Plugins\DocumentToImagePlugin\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <OutputPath>..\..\Ink Canvas\Plugins\DocumentToImagePlugin\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <OutputPath>..\..\Ink Canvas\Plugins\DocumentToImagePlugin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用宿主 EXE 中的插件接口，但不把主程序文件复制到插件输出目录 -->
    <ProjectReference Include="..\..\Ink Canvas\Ink Canvas.csproj">
      <Private>false</Private>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 开源 Office 文档读取库，无需安装 Microsoft Office -->
    <PackageReference Include="NPOI" Version="2.5.6" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <!-- 不带 V8/XFA 的 pdfium 原生包，仅用于 PDF 转图片，体积从约 13MB 降到约 2MB -->
    <PackageReference Include="PdfiumViewer.Native.x86.no_v8-no_xfa" Version="2018.4.8.256" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="ReachFramework" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Printing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件清单与打包脚本：生成时复制到 ICU 插件目录 -->
    <None Include="plugin.icplugin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="pack.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 插件通过 ProjectReference 引用主程序，导致主程序的依赖 DLL 被复制到插件输出目录。
       这些 DLL 在主程序输出中已存在，随插件重复打包会显著增加安装包体积。
       生成后删除重复/废弃的 DLL，仅保留插件自身依赖（NPOI、PdfiumViewer、pdfium 等）。 -->
  <Target Name="RemoveDuplicateHostDependencies" AfterTargets="Build">
    <ItemGroup>
      <DuplicateHostDlls Include="$(TargetDir)iNKORE.UI.WPF.Modern.dll" />
      <DuplicateHostDlls Include="$(TargetDir)iNKORE.UI.WPF.Modern.Controls.dll" />
      <DuplicateHostDlls Include="$(TargetDir)iNKORE.UI.WPF.dll" />
      <DuplicateHostDlls Include="$(TargetDir)Newtonsoft.Json.dll" />
      <DuplicateHostDlls Include="$(TargetDir)OSVersionExt.dll" />
      <DuplicateHostDlls Include="$(TargetDir)System.ValueTuple.dll" />
      <DuplicateHostDlls Include="$(TargetDir)Office.dll" />
      <DuplicateHostDlls Include="$(TargetDir)Microsoft.Office.Interop.PowerPoint.dll" />
      <DuplicateHostDlls Include="$(TargetDir)Microsoft.Office.Interop.Word.dll" />
      <DuplicateHostDlls Include="$(TargetDir)Microsoft.Office.Interop.Excel.dll" />
      <DuplicateHostDlls Include="$(TargetDir)AForge.dll" />
      <DuplicateHostDlls Include="$(TargetDir)AForge.Imaging.dll" />
      <DuplicateHostDlls Include="$(TargetDir)AForge.Math.dll" />
      <DuplicateHostDlls Include="$(TargetDir)AForge.Video.dll" />
      <DuplicateHostDlls Include="$(TargetDir)AForge.Video.DirectShow.dll" />
    </ItemGroup>
    <Delete Files="@(DuplicateHostDlls)" ContinueOnError="true" />
  </Target>

  <!-- 主项目先构建，插件后构建；插件构建完成后把清理过的输出复制到主程序输出目录，
       保证一次性生成即可获得完整插件目录。 -->
  <Target Name="CopyPluginToHostOutput" AfterTargets="RemoveDuplicateHostDependencies">
    <PropertyGroup>
      <HostOutputDir>$(ProjectDir)..\..\Ink Canvas\bin\$(Configuration)\</HostOutputDir>
      <HostPluginDir>$(HostOutputDir)Plugins\DocumentToImagePlugin\</HostPluginDir>
    </PropertyGroup>
    <ItemGroup>
      <PluginOutputFiles Include="$(TargetDir)**\*" Exclude="$(TargetDir)obj\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(HostPluginDir)" />
    <Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="$(HostPluginDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
