<Window x:Class="Ink_Canvas.Plugins.DocumentToImage.UI.ConversionProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文档转换进度"
        Width="420"
        Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="FileNameTextBlock"
            Grid.Row="0"
            FontSize="14"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis" />
        <ProgressBar
            x:Name="ProgressBar"
            Grid.Row="1"
            Height="18"
            Margin="0,10,0,0"
            Minimum="0"
            Maximum="100" />
        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="2"
            Margin="0,8,0,0"
            FontSize="13"
            Foreground="Gray" />
    </Grid>
</Window>
