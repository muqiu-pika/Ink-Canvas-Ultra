<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PptControlCustomizerPlugin</AssemblyName>
    <RootNamespace>Ink_Canvas.Plugins.PptControlCustomizer</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>embedded</DebugType>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主程序集：提供 IPlugin / IPluginHost / PluginManifest 契约。
         插件复用宿主已加载的程序集（Private=false），因此除自身 DLL 外不打包任何额外依赖。
         构建本插件前需先构建宿主（Ink Canvas.sln 的 Release 配置）。 -->
    <Reference Include="Ink Canvas Ultra">
      <HintPath>..\Ink Canvas\bin\Release\Ink Canvas Ultra.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- JavaScriptSerializer 用于读写简洁 JSON 配置，避免引入额外包 -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件清单与打包脚本 -->
    <None Include="plugin.icplugin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="pack.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
