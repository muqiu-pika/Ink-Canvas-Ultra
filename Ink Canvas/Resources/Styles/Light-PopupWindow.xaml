<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PopupWindowBackground" Opacity="0.95" Color="#F0F3F9" />
    <SolidColorBrush x:Key="PopupWindowBorderBrush" Opacity="0.8" Color="#0066BF" />
    <SolidColorBrush x:Key="PopupWindowForeground" Color="Black" />

    <SolidColorBrush x:Key="PopupWindowDarkBlueBorderBackground" Opacity="0.9" Color="#0066BF" />
    <SolidColorBrush x:Key="PopupWindowDarkBlueBorderBrush" Opacity="0.8" Color="#0066BF" />
    <SolidColorBrush x:Key="PopupWindowDarkBlueBorderForeground" Opacity="0.8" Color="White" />

    <!-- 插件有可用更新时，新版本号的强调色（浅色底 #F0F3F9 上用较深琥珀色保证对比度） -->
    <SolidColorBrush x:Key="PopupWindowUpdateAccentBrush" Color="#B45309" />
</ResourceDictionary>