<Window x:Class="Ink_Canvas.PluginSystemRequirementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="需要 Windows 系统组件"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PopupWindowBackground}"
        Foreground="{DynamicResource PopupWindowForeground}"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Border BorderBrush="{DynamicResource PopupWindowBorderBrush}" BorderThickness="1" Padding="18,14">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource PopupWindowForeground}" />
            <TextBlock x:Name="DetailText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource PopupWindowForeground}" />

            <TextBlock x:Name="MethodText" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource PopupWindowForeground}" />

            <Button x:Name="BtnElevatedInstall" Content="以管理员身份一键安装（推荐）"
                    Padding="10,5" Margin="0,12,0,0" HorizontalAlignment="Left"
                    FontWeight="SemiBold" Click="BtnElevatedInstall_Click" />

            <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="#888888" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="打开 Windows 设置" Padding="10,4" Margin="0,0,8,0" Click="BtnOpenSettings_Click" />
                <Button Content="复制安装命令" Padding="10,4" Click="BtnCopyCommand_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Padding="18,4" IsCancel="True" Click="BtnCancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
