<Window x:Class="Ink_Canvas.ScreenshotInsertOptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ink_Canvas"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="截图已成功 - Ink Canvas Ultra"
        Width="440"
        SizeToContent="Height"
        ui:ThemeManager.RequestedTheme="Light"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:WindowHelper.UseModernWindowStyle="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <Window.Resources>
        <!-- 选项按钮：白底圆角卡片 + 1px 浅描边，悬停/按下用中性淡色，去掉原各自阴影，更简约 -->
        <Style x:Key="OptionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="12,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消按钮：次级按钮样式（灰底） -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PopupWindowForeground}"/>
        </Style>

        <Style x:Key="OptionDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border Margin="10" Padding="24"
            Background="{DynamicResource PopupWindowBackground}"
            BorderBrush="{DynamicResource PopupWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：FontIcon + 标题 + 徽标（与其它通知窗口一致） -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:FontIcon Width="32" Height="32"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 FontFamily="{StaticResource FluentIconFontFamily}"
                                 FontSize="26"
                                 Foreground="{DynamicResource PopupWindowDarkBlueBorderBackground}"
                                 Glyph="&#xE8FB;"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PopupWindowForeground}"
                               Text="截图已成功"/>
                    <Border Margin="10,0,0,0" Padding="6,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PopupWindowDarkBlueBorderBackground}"
                            CornerRadius="4">
                        <TextBlock Height="18"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource PopupWindowDarkBlueBorderForeground}"
                                   Text="截图"/>
                    </Border>
                </StackPanel>
                <TextBlock Margin="44,8,0,0"
                           FontSize="13"
                           Foreground="#6B7280"
                           Text="请选择截图插入位置"/>
            </StackPanel>

            <!-- 选项区 -->
            <StackPanel Grid.Row="1">
                <Button x:Name="BtnInsertToCanvas"
                        Style="{StaticResource OptionButtonStyle}"
                        Click="BtnInsertToCanvas_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44"
                                Background="#EEF2FF"
                                CornerRadius="10"
                                Margin="0,0,14,0">
                            <TextBlock Text="&#xE7C4;"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="22"
                                       Foreground="#4A6CF7"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="插入到画板"
                                       Style="{StaticResource OptionTitleStyle}"/>
                            <TextBlock Text="将截图插入到当前画布中，支持移动和缩放"
                                       Style="{StaticResource OptionDescStyle}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="BtnInsertToBoard"
                        Style="{StaticResource OptionButtonStyle}"
                        Click="BtnInsertToBoard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44"
                                Background="#F0FDF4"
                                CornerRadius="10"
                                Margin="0,0,14,0">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="22"
                                       Foreground="#22C55E"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="插入到白板照片列表"
                                       Style="{StaticResource OptionTitleStyle}"/>
                            <TextBlock Text="将截图添加到白板右侧的照片列表中"
                                       Style="{StaticResource OptionDescStyle}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="BtnCopyToClipboard"
                        Style="{StaticResource OptionButtonStyle}"
                        Click="BtnCopyToClipboard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44"
                                Background="#FFF7ED"
                                CornerRadius="10"
                                Margin="0,0,14,0">
                            <TextBlock Text="&#xE8C8;"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="22"
                                       Foreground="#F59E0B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="复制到剪贴板"
                                       Style="{StaticResource OptionTitleStyle}"/>
                            <TextBlock Text="保存为图片文件并复制到剪贴板"
                                       Style="{StaticResource OptionDescStyle}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- 取消 -->
            <Button Grid.Row="2"
                    x:Name="BtnCancel"
                    Content="取消"
                    Style="{StaticResource CancelButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="BtnCancel_Click"/>
        </Grid>
    </Border>
</Window>
